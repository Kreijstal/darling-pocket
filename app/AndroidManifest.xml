<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.kreijstal.darlingpocket">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The iOS apps' alarms and notifications, when Darling is not running (Alarms). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Debuggable while the runtime is brought up: `adb shell run-as` reads the logs.
         Attributes go in resource-id order (label, name, debuggable, exported, launchMode,
         configChanges, allowBackup): Android reads them in that order and skips any out of it,
         and the binary encoder keeps the order written here. -->
    <application android:label="Darling Pocket" android:debuggable="true"
        android:allowBackup="false">
        <service android:name=".PocketService" android:exported="false" />
        <receiver android:name=".Alarms" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:label="Darling Pocket" android:name=".MainActivity"
            android:exported="true" android:launchMode="2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- configChanges: orientation, screen layout and size, keyboard, density -->
        <activity android:label="iOS" android:name=".ScreenActivity"
            android:exported="false" android:launchMode="2" android:configChanges="7600" />
    </application>
</manifest>
